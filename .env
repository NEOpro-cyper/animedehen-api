# ─── TaroFlix Data API configuration ───
# Copy to .env (or export in your process manager / shell) and adjust.

# Port the API listens on
PORT=4000

# Source site to scrape (all catalog/stream data comes from here)
SITE_URL=https://animeidhentai.com

# CORS: which browser origin may call this API.
# "*" = any (fine for testing). For production set your site origin:
# ALLOWED_ORIGIN=https://your-site.com
ALLOWED_ORIGIN=*

# Optional shared secret. When set, every request must send the header
# "x-api-key: <key>" or "?key=<key>". Leave empty to disable.
API_KEY=

# Cache TTLs in seconds
CACHE_TTL_SHORT=300     # episode / series / search pages (5 min)
CACHE_TTL_MED=900       # trending / browse lists (15 min)
CACHE_TTL_LONG=86400    # genres (24 h)
